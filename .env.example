# Copy this file to .env and change the values for your machine.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# True puts Django's admin site at /admin/. False makes /admin redirect to the app's admin dashboard.
SHOW_ADMIN_ROUTES=False

TIME_ZONE=Asia/Manila
LOG_LEVEL=INFO

# Database: "sqlite" for development, "mysql" for production.
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# The PHP application's database, read by `python manage.py import_php_data`.
# Leave LEGACY_DB_NAME empty when there is nothing to import.
LEGACY_DB_NAME=
LEGACY_DB_USER=root
LEGACY_DB_PASSWORD=
LEGACY_DB_HOST=localhost
LEGACY_DB_PORT=3306

# ElevenLabs: the tiles' voices. Get a key at https://elevenlabs.io/app/settings/api-keys.
# ELEVENLABS_VOICE_ID is the shared Filipino voice used by `python manage.py generate_tile_audio`;
# family voices are cloned in the app. eleven_multilingual_v2 is a model that lists Filipino.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
